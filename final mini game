// DOAN SO
void DoanSo () {
	int guess; int streak = 0; int level = 0; int secret; char play = 'y';
	// choi lai
	while (play == 'y' || play == 'Y') {
		streak = 0;
	// tieu de
	printf("====================\n");
	printf("  TRO CHOI DOAN SO \n");
	printf("====================\n");
	printf("Hay doan mot so bi mat!\n");
	printf("\n");
	
	// chon do kho
	printf("----------- DO KHO -----------\n");
	printf("1. De: 0 -> 50\n");
	printf("2. Trung binh: 0 -> 100\n");
	printf("3. Kho: 0 -> 500\n");
	printf("-------------------------------\n");
	printf("\n");
	printf("Chon do kho: ");
	scanf("%d", &level);
	printf("\n");
	
	// random so
	srand(time(NULL));
	while (level != 1 && level != 2 && level != 3) {
	printf("Chon lai do kho: ");
	scanf("%d", &level);
	}
	if (level == 1) {
	secret = rand() % 51; 
	printf(">>> Ban da chon do kho 1 (0 - 50)\n");
	}
	else if (level == 2) {
	secret = rand() % 101;
	printf(">>> Ban da chon do kho 2 (0 - 100)\n");
	}
	else if (level == 3) {
	secret = rand() % 501;
	printf(">>> Ban da chon do kho 3 (0 - 500)\n");
	}
	printf("\n");
	printf("-------------------------------\n");
	
	// nguoi choi doan
	printf("Nhap so doan: ");
	scanf("%d", &guess);
	streak++;
	printf("\n");
	
	// doan
	if (guess == secret) {
		printf("CHUC MUNG! BAN DA DOAN DUNG!\n");
		printf("--------------------------------");
	}
	while (guess != secret) {
		if (guess > secret) {
			printf("[!] So can doan NHO HON\n");

		}
		if (guess < secret) {
			printf("[!] So can doan LON HON\n");
	
		}
		printf("Nhap lai so: ");
		scanf("%d", &guess);
		streak++;
		printf("\n");
	}
	printf("Ban da dung!\n");
	printf("\n");
	// so lan doan
	printf("So lan doan cua ban: %d\n", streak);
	// choi lai
	printf("Ban muon choi lai khong? (y/n): ");
	scanf(" %c", &play);
	printf("\n");
	system("cls");
}
}


// DOAN TU
void DoanTu (){
    int group, tu, i;
    char *secret, doan;
    char play = 'y';

    while (play == 'y' || play == 'Y') {

        system("cls"); 

        srand(time(NULL));

        printf("=====================================\n");
        printf("        TRO CHOI DOAN TU\n");
        printf("=====================================\n");

        // danh sach tu
        char fruits[][20] = {"apple","banana","grape","mango","orange","lemon","peach","melon","cherry","papaya"};
        char animals[][20] = {"cat","dog","tiger","lion","zebra","horse","sheep","goat","monkey","panda","rabbit","mouse","snake","eagle","shark","whale","dolphin","turtle","spider","butterfly"};
        char colors[][20] = {"red","blue","green","black","white","yellow","purple","orange","pink","brown"};
        
        // chon nhom
        group = rand() % 3;
        
        // chon tu + goi y
        if (group == 0) {
            printf("-> Goi y: Trai cay\n");
            tu = rand() % 10;
            secret = fruits[tu];
        }
        else if (group == 1) {
            printf("-> Goi y: Dong vat\n");
            tu = rand() % 20;
            secret = animals[tu];
        }
        else {
            printf("-> Goi y: Mau sac\n");
            tu = rand() % 10;
            secret = colors[tu];
        }

        int len = strlen(secret);
        char display[20];

        printf("\n>> Tu can doan: ");
        for (i = 0; i < len; i++) {
            printf("_ ");
            display[i] = '_';
        }
        display[len] = '\0';

        printf("\n-------------------------------------\n");

        // game loop
        while (strcmp(display, secret) != 0) {

            int found = 0;

            printf("\nNhap chu ban doan: ");
            scanf(" %c", &doan);

            for (i = 0; i < len; i++) {
                if (secret[i] == doan) {
                    display[i] = doan;
                    found = 1;
                }
            }

            if (found)
                printf("[!] Doan dung!\n");
            else
                printf("[!] Sai roi!\n");

            printf("Trang thai: ");
            for (i = 0; i < len; i++) {
                printf("%c ", display[i]);
            }
            printf("\n");
        }

        printf("\n=====================================\n");
        printf("CHUC MUNG! BAN DA DOAN DUNG!\n");
        printf("Tu can doan la: %s\n", secret);
        printf("=====================================\n");

        // choi lai
        printf("Ban muon choi lai khong? (y/n): ");
        scanf(" %c", &play);
        system("cls");
    }
}


