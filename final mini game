// XO
int Checkwin (char a[3][3]){
    for (int i=0; i<3;i++){
        if (a[i][0]==a[i][1]&&a[i][1]==a[i][2]&&a[i][0]!=' '){
            return 1;
        }
    }for (int i=0; i<3 ;i++){
        if (a[0][i]==a[1][i]&&a[1][i]==a[2][i]&&a[0][i]!=' '){
            return 1;
        }
    }if (a[0][0]==a[1][1]&&a[1][1]==a[2][2]&&a[0][0]!=' '){
        return 1;
    }if (a[2][0]==a[1][1]&&a[1][1]==a[0][2]&&a[2][0]!=' '){
        return 1;
    }return 0;
}

int Checktie(char a[3][3]){
    for (int m=0;m<3;m++){
        for (int n=0;n<3;n++){
            if (a[m][n]==' '){
                return 0;
            }
        }
    }
    return 1;
}

void inbang (char a[3][3]){
    for(int i=0;i<3;i++){
        for(int j=0;j<3;j++){
            printf(" %c ",a[i][j]);
            if(j<2) printf("|");
        }
        printf("\n");
        if(i<2) printf("---|---|---\n");
    }
}

void XO(){
    char play = 'y'; 
    while (play == 'y' || play == 'Y') {   

        char a[3][3];
        for (int x=0;x<3;x++){
            for (int y=0;y<3;y++){
                a[x][y]=' ';
            }
        }
        inbang(a);
        Checktie(a);

        while (1){
            int m,n;
            printf ("nguoi 1 nhap 'x' o hang, cot: ");
            scanf ("%d%d",&m,&n);
            if(m<0 || m>2 || n<0 || n>2){
                printf("Nhap sai!\n");
                continue;
            }if(a[m][n] != ' '){
                printf("O nay da duoc danh!\n");
                continue;
            }
            a[m][n]='x';
            inbang(a);
            if (Checkwin(a)){
                printf ("WIN\n");
                break;
            }if(Checktie(a)){
                printf("Hoa!\n");
                break;
            }
            printf ("nguoi 2 nhap 'o' o hang, cot: ");
            scanf ("%d%d",&m,&n);
            if(m<0 || m>2 || n<0 || n>2){
                printf("Nhap sai!\n");
                continue;
            }if(a[m][n] != ' '){
                printf("O nay da duoc danh!\n");
                continue;
            }
            a[m][n]='o';
            inbang(a);
            if (Checkwin(a)){
                printf ("WIN\n");
                break;
            }if(Checktie(a)){
                printf("Hoa!\n");
                break;
            }
        }
        printf("Ban muon choi lai khong? (y/n): ");
        scanf(" %c", &play);
        system("cls");
    }
}


